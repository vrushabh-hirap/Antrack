<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/class_item_bg"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Class Icon -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/class_icon_bg"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/tvClassIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖"
            android:textSize="24sp" />

    </LinearLayout>

    <!-- Class Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvClassName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mathematics"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvClassDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Grade 10 • 25 Students"
            android:textColor="#C0FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLastAttendance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Last attendance: Today"
            android:textColor="#A0FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Action Menu -->
    <ImageButton
        android:id="@+id/btnClassMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Class options"
        android:src="@android:drawable/ic_menu_more" />

</LinearLayout>